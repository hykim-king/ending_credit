<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.endit.mapper.PersonLikeMapper">

    <!-- searchDiv: 10(회원 번호), 20(인물 번호) -->
    <sql id="personLikeWhere">
        <where>
            <if test="searchWord != null and searchWord != ''">
                <choose>
                    <when test="searchDiv == '10'">
                        AND PL.MEMBER_ID = #{searchNumber,jdbcType=NUMERIC}
                    </when>
                    <when test="searchDiv == '20'">
                        AND PL.PERSON_ID = #{searchNumber,jdbcType=NUMERIC}
                    </when>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 인물 좋아요 등록 -->
    <insert id="doSave" parameterType="PersonLikeVO">
        INSERT INTO PERSON_LIKE (
            MEMBER_ID,
            PERSON_ID,
            CREATED_DT
        ) VALUES (
            #{memberId},
            #{personId},
            SYSDATE
        )
    </insert>

    <!-- 인물 좋아요 단건 조회: 복합 PK 전체 사용 -->
    <select id="doSelectOne" parameterType="PersonLikeVO" resultType="PersonLikeVO">
        SELECT MEMBER_ID,
               PERSON_ID,
               TO_CHAR(CREATED_DT, 'YYYY-MM-DD HH24:MI:SS') AS CREATED_DT
          FROM PERSON_LIKE
         WHERE MEMBER_ID = #{memberId}
           AND PERSON_ID = #{personId}
    </select>

    <!-- 인물 좋아요 삭제: 복합 PK 전체 사용 -->
    <delete id="doDelete" parameterType="PersonLikeVO">
        DELETE FROM PERSON_LIKE
         WHERE MEMBER_ID = #{memberId}
           AND PERSON_ID = #{personId}
    </delete>

    <select id="doRetrieve" parameterType="com.endit.cmn.DTO" resultType="PersonLikeVO">
        SELECT MEMBER_ID,
               PERSON_ID,
               CREATED_DT,
               EXTERNAL_ID,
               NAME_KO,
               NAME_ORG,
               PROFILE_IMAGE_URL
          FROM (
            SELECT PL.MEMBER_ID,
                   PL.PERSON_ID,
                   TO_CHAR(PL.CREATED_DT, 'YYYY-MM-DD HH24:MI:SS') AS CREATED_DT,
                   P.EXTERNAL_ID,
                   P.NAME_KO,
                   P.NAME_ORG,
                   P.PROFILE_IMAGE_URL,
                   ROW_NUMBER() OVER (
                       ORDER BY PL.CREATED_DT DESC, PL.MEMBER_ID DESC, PL.PERSON_ID DESC
                   ) AS RNUM
              FROM PERSON_LIKE PL
              JOIN PERSON P
                ON P.PERSON_ID = PL.PERSON_ID
            <include refid="personLikeWhere"/>
        )
        <if test="pageNo > 0 and pageSize > 0">
         WHERE RNUM BETWEEN ((#{pageNo} - 1) * #{pageSize} + 1)
                         AND (#{pageNo} * #{pageSize})
        </if>
         ORDER BY RNUM
    </select>

    <!-- 인물 좋아요 전체 삭제 -->
    <delete id="deleteAll">
        DELETE FROM PERSON_LIKE
    </delete>

    <!-- 인물 좋아요 전체 건수 조회 -->
    <select id="totalCnt" resultType="int">
        SELECT COUNT(*)
          FROM PERSON_LIKE
    </select>

    <select id="count" parameterType="com.endit.cmn.DTO" resultType="int">
        SELECT COUNT(*)
          FROM PERSON_LIKE PL
        <include refid="personLikeWhere"/>
    </select>

</mapper>

# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env 는 git 에 올라가지 않는다.

# mock | openai | claude
AI_PROVIDER=mock

# AI_PROVIDER=openai 일 때만 필요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI_PROVIDER=claude 일 때만 필요
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# 임베딩(뜻 좌표) 저울: hash | local | openai
# hash 는 배관 검증용 가짜(뜻 없음). local 은 sentence-transformers 설치 필요
EMBED_PROVIDER=hash
